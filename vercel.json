{
  "framework": null,
  "outputDirectory": ".",
  "buildCommand": "node scripts/write-env.js",
  "functions": {
    "api/signup.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ]
}
